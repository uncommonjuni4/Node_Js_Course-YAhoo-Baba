
<%- include('partials/header.ejs') %>

<div>
    <main class="py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4">
          
          <!-- Card Header -->
          <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
            <h5 class="mb-0 fw-bold text-dark">
              <i class="bi bi-person-vcard-fill text-primary me-2"></i>Contact Details
            </h5>
            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">Profile View</span>
          </div>           

          <!-- Card Body -->
          <div class="card-body p-4">
            
            <!-- First Name -->
            <div class="row py-2 border-bottom align-items-center">
              <div class="col-sm-4 text-secondary fw-semibold small">
                <i class="bi bi-person me-2 text-muted"></i>First Name
              </div>
              <div class="col-sm-8">
                <p class="mb-0 fw-medium text-dark">Mark</p>
              </div>
            </div>

            <!-- Last Name -->
            <div class="row py-2 border-bottom align-items-center">
              <div class="col-sm-4 text-secondary fw-semibold small">
                <i class="bi bi-person me-2 text-muted"></i>Last Name
              </div>
              <div class="col-sm-8">
                <p class="mb-0 fw-medium text-dark">Otto</p>
              </div>
            </div>

            <!-- Email -->
            <div class="row py-2 border-bottom align-items-center">
              <div class="col-sm-4 text-secondary fw-semibold small">
                <i class="bi bi-envelope me-2 text-muted"></i>Email
              </div>
              <div class="col-sm-8">
                <p class="mb-0 text-dark">mark.otto@example.com</p>
              </div>
            </div>

            <!-- Phone -->
            <div class="row py-2 border-bottom align-items-center">
              <div class="col-sm-4 text-secondary fw-semibold small">
                <i class="bi bi-telephone me-2 text-muted"></i>Phone
              </div>
              <div class="col-sm-8">
                <p class="mb-0 text-dark">03490819238</p>
              </div>
            </div>

            <!-- Address -->
            <div class="row py-2 align-items-center">
              <div class="col-sm-4 text-secondary fw-semibold small">
                <i class="bi bi-geo-alt me-2 text-muted"></i>Address
              </div>
              <div class="col-sm-8">
                <p class="mb-0 text-dark">Lahore, Pakistan</p>
              </div>
            </div>

            <hr class="my-4 text-muted">

            <!-- Action Buttons -->
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
              <a href="/" class="btn btn-light border px-4 rounded-pill">
                <i class="bi bi-arrow-left me-1"></i> Back
              </a>
              
              <div class="d-flex gap-2">
                <a href="/add-contact" class="btn btn-warning text-dark px-4 rounded-pill shadow-sm">
                  <i class="bi bi-pencil-square me-1"></i> Edit
                </a>
                <a href="/delete" class="btn btn-outline-danger px-4 rounded-pill">
                  <i class="bi bi-trash me-1"></i> Delete
                </a>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</main>
</div>




<%- include('partials/footer.ejs') %>